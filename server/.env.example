# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (mobile apps send no Origin, so this
# mainly guards any web dashboard). Use * only in dev.
CORS_ORIGINS=*

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
# Set to "true" to bypass real Twilio and accept OTP 000000 in dev.
OTP_DEV_MODE=true

# Server sealing keypair (Curve25519, base64). The app seals SOS payloads to the
# PUBLIC half (src/config.ts -> serverPublicKey); the server opens with this
# SECRET half. Regenerate for production:
#   node -e "const n=require('tweetnacl'),u=require('tweetnacl-util');const k=n.box.keyPair();console.log('pub',u.encodeBase64(k.publicKey));console.log('sec',u.encodeBase64(k.secretKey))"
SERVER_SEAL_SECRET=DyhLGtTvcjxr12WwiVBEytxWWCeheMpVYyHXDajELQc=

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pulse
DB_PASSWORD=pulse
DB_NAME=pulse
DB_CONNECTION_LIMIT=10

# ---- Twilio (OTP + SMS fallback) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_FROM=

# ---- Push (choose one; FCM used by default) ----
FCM_SERVER_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
